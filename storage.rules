rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'jtejeshwartej@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024;
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*')
        && request.resource.size < 300 * 1024 * 1024;
    }

    function isDoc() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('application/msword')
        || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
        || request.resource.contentType.matches('text/plain');
    }
    function isDocSize() {
      return request.resource.size < 40 * 1024 * 1024;
    }

    function isModel() {
      return request.resource.size < 100 * 1024 * 1024
        && (request.resource.name.matches('.*\\.glb$')
          || request.resource.name.matches('.*\\.gltf$')
          || request.resource.name.matches('.*\\.obj$')
          || request.resource.name.matches('.*\\.bin$')
          || request.resource.contentType.matches('model/.*')
          || request.resource.contentType.matches('application/octet-stream'));
    }

    function isAnimation() {
      return (request.resource.contentType.matches('image/gif')
          || request.resource.contentType.matches('video/mp4')
          || request.resource.contentType.matches('video/webm'))
        && request.resource.size < 100 * 1024 * 1024;
    }

    // Public assets: everyone can read, only the admin can write —
    // and only when the file actually matches the folder's expected
    // type and size ceiling.
    match /gallery/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage();
    }
    match /projects/{projectId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && (isImage() || isVideo());
    }
    match /videos/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isVideo();
    }
    match /documents/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isDoc() && isDocSize();
    }
    match /presentations/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isDoc() && isDocSize();
    }
    match /models/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isModel();
    }
    match /animations/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isAnimation();
    }
    match /resume/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.contentType.matches('application/pdf')
        && request.resource.size < 15 * 1024 * 1024;
    }
    match /achievements/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && (isImage() || (isDoc() && isDocSize()));
    }
    match /profile/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage();
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
