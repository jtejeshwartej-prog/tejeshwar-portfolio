# ------------------------------------------------------------------
# Firebase Web App config — get these from:
# Firebase Console → Project Settings → General → Your apps → Web app
# These "web config" values are NOT secret keys; they are safe to ship
# in a client bundle. Real security comes from firestore.rules /
# storage.rules and the admin-email check, not from hiding these.
# ------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The ONLY Google account allowed into /admin.
# Must match exactly (lowercase) — enforced both client-side (UX) and
# in firestore.rules / storage.rules (actual security).
VITE_ADMIN_EMAIL=jtejeshwartej@gmail.com

# Optional: reCAPTCHA v3 site key for the contact form (App Check / spam protection)
VITE_RECAPTCHA_SITE_KEY=
